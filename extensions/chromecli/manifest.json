{
  "manifest_version": 3,
  "name": "chromecli",
  "version": "0.7.1",
  "description": "Share Chrome tabs, one at a time, with the chromecli command (read-only). Native host: com.truefrontier.chromecli.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "chromecli",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["tabs", "storage", "scripting", "activeTab", "history", "nativeMessaging", "alarms"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "pause-agents": {
      "suggested_key": { "default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period" },
      "description": "Pause / resume agents (every chromecli command but status exits 4)"
    }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
